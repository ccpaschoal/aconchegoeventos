{
  "name": "aconchego-site",
  "private": true,
  "type": "module",
  "description": "Site do Aconchego Festas e Eventos com reservas online (Cloudflare Workers + D1 + Mercado Pago)",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs && wrangler dev",
    "banco:local": "wrangler d1 migrations apply aconchego --local",
    "banco": "wrangler d1 migrations apply aconchego --remote",
    "deploy": "node build.mjs && wrangler deploy"
  }
}
